    "#%% ------------------------------------------------------------\n",
    "# BLOQUE 6 — Geometría de electrodos en malla cuadrada regular\n",
    "# Malla de 25 m x 25 m con 96 electrodos\n",
    "# ------------------------------------------------------------\n",
    "\n",
    "import matplotlib.pyplot as plt\n",
    "import matplotlib as mpl\n",
    "\n",
    "# ============================================================\n",
    "# Parámetros del experimento\n",
    "# ============================================================\n",
    "\n",
    "geometry_type = \"malla_cuadrada_96\"\n",
    "\n",
    "# Tamaño físico del cuadrado de electrodos [m]\n",
    "grid_size_x = 25.0\n",
    "grid_size_y = 25.0\n",
    "\n",
    "# Malla base regular\n",
    "# 10 x 10 = 100 puntos; se eliminan las cuatro esquinas para obtener 96 electrodos.\n",
    "n_base_x = 10\n",
    "n_base_y = 10\n",
    "\n",
    "n_elec_target = 96\n",
    "\n",
    "# Electrodos en superficie\n",
    "z_elec = 0.0\n",
    "\n",
    "# Centro de la malla dentro del dominio\n",
    "x_center = 0.5 * Lx\n",
    "y_center = 0.5 * Ly\n",
    "\n",
    "# ============================================================\n",
    "# Cálculo automático del espaciamiento\n",
    "# ============================================================\n",
    "\n",
    "if n_base_x < 2 or n_base_y < 2:\n",
    "    raise ValueError(\"La malla base debe tener al menos 2 electrodos en x y 2 en y.\")\n",
    "\n",
    "a_elec_x = grid_size_x / (n_base_x - 1)\n",
    "a_elec_y = grid_size_y / (n_base_y - 1)\n",
    "\n",
    "if not np.isclose(a_elec_x, a_elec_y):\n",
    "    raise ValueError(\n",
    "        f\"El espaciamiento no es igual en x e y: \"\n",
    "        f\"a_elec_x={a_elec_x:.3f} m, a_elec_y={a_elec_y:.3f} m.\"\n",
    "    )\n",
    "\n",
    "a_elec = a_elec_x\n",
    "\n",
    "# ============================================================\n",
    "# Coordenadas extremas del cuadrado\n",
    "# ============================================================\n",
    "\n",
    "x_start = x_center - 0.5 * grid_size_x\n",
    "x_end   = x_center + 0.5 * grid_size_x\n",
    "\n",
    "y_start = y_center - 0.5 * grid_size_y\n",
    "y_end   = y_center + 0.5 * grid_size_y\n",
    "\n",
    "# ============================================================\n",
    "# Validación geométrica\n",
    "# ============================================================\n",
    "\n",
    "if x_start < 0.0 or x_end > Lx or y_start < 0.0 or y_end > Ly:\n",
    "    raise ValueError(\n",
    "        f\"La malla de electrodos no cabe en el dominio.\\n\"\n",
    "        f\"x_start={x_start:.2f}, x_end={x_end:.2f}, Lx={Lx:.2f}\\n\"\n",
    "        f\"y_start={y_start:.2f}, y_end={y_end:.2f}, Ly={Ly:.2f}\\n\"\n",
    "        f\"Reduce grid_size_x/grid_size_y o aumenta Lx/Ly.\"\n",
    "    )\n",
    "\n",
    "# ============================================================\n",
    "# Construcción de la malla base 10 x 10\n",
    "# ============================================================\n",
    "\n",
    "x_grid = np.linspace(x_start, x_end, n_base_x)\n",
    "y_grid = np.linspace(y_start, y_end, n_base_y)\n",
    "\n",
    "X_base, Y_base = np.meshgrid(x_grid, y_grid, indexing=\"xy\")\n",
    "Z_base = np.full_like(X_base, z_elec)\n",
    "\n",
    "# ============================================================\n",
    "# Eliminación de las cuatro esquinas para obtener 96 electrodos\n",
    "# ============================================================\n",
    "\n",
    "keep_mask = np.ones((n_base_y, n_base_x), dtype=bool)\n",
    "\n",
    "# Esquinas de la malla base\n",
    "keep_mask[0, 0] = False\n",
    "keep_mask[0, -1] = False\n",
    "keep_mask[-1, 0] = False\n",
    "keep_mask[-1, -1] = False\n",
    "\n",
    "# Coordenadas vectorizadas finales\n",
    "x_elec = X_base[keep_mask].ravel()\n",
    "y_elec = Y_base[keep_mask].ravel()\n",
    "z_elec_vec = Z_base[keep_mask].ravel()\n",
    "\n",
    "# Número total de electrodos\n",
    "n_elec = len(x_elec)\n",
    "\n",
    "if n_elec != n_elec_target:\n",
    "    raise ValueError(\n",
    "        f\"La geometría generó {n_elec} electrodos, \"\n",
    "        f\"pero se esperaban {n_elec_target}.\"\n",
    "    )\n",
    "\n",
    "# ============================================================\n",
    "# Construcción explícita de coordenadas e índices\n",
    "# ============================================================\n",
    "\n",
    "electrode_xyz = list(zip(x_elec, y_elec, z_elec_vec))\n",
    "electrode_p = [xyz_to_p(x, y, z) for (x, y, z) in electrode_xyz]\n",
    "\n",
    "# Alias para mantener compatibilidad con bloques posteriores\n",
    "x_line = x_elec\n",
    "y_line = y_elec\n",
    "z_line = z_elec_vec\n",
    "\n",
    "# La malla base sí es regular, pero se eliminaron cuatro esquinas\n",
    "electrode_grid_shape = (n_base_y, n_base_x)\n",
    "electrode_grid_mask = keep_mask\n",
    "\n",
    "# ============================================================\n",
    "# Validación de duplicados por discretización\n",
    "# ============================================================\n",
    "\n",
    "unique_p = np.unique(electrode_p)\n",
    "\n",
    "if len(unique_p) < len(electrode_p):\n",
    "    print(\"ADVERTENCIA:\")\n",
    "    print(\n",
    "        f\"Hay {len(electrode_p) - len(unique_p)} electrodos que caen \"\n",
    "        \"en celdas repetidas de la malla numérica.\"\n",
    "    )\n",
    "    print(\n",
    "        \"Esto puede ocurrir si el espaciamiento entre electrodos es menor \"\n",
    "        \"o comparable con el tamaño de celda local.\"\n",
    "    )\n",
    "\n",
    "# ============================================================\n",
    "# Información útil\n",
    "# ============================================================\n",
    "\n",
    "left_margin   = x_grid[0]\n",
    "right_margin  = Lx - x_grid[-1]\n",
    "bottom_margin = y_grid[0]\n",
    "top_margin    = Ly - y_grid[-1]\n",
    "\n",
    "print(\"Geometría de electrodos: malla cuadrada regular de 96 electrodos\")\n",
    "print(\"----------------------------------------------------------------\")\n",
    "print(f\"Tipo de geometría: {geometry_type}\")\n",
    "print(f\"Tamaño de la malla: {grid_size_x:.2f} m x {grid_size_y:.2f} m\")\n",
    "print(f\"Malla base: {n_base_x} x {n_base_y} = {n_base_x*n_base_y} puntos\")\n",
    "print(\"Electrodos removidos: 4 esquinas\")\n",
    "print(f\"Número total de electrodos: {n_elec}\")\n",
    "print(f\"Espaciamiento en x: {a_elec_x:.3f} m\")\n",
    "print(f\"Espaciamiento en y: {a_elec_y:.3f} m\")\n",
    "print(f\"x inicial: {x_grid[0]:.3f} m\")\n",
    "print(f\"x final:   {x_grid[-1]:.3f} m\")\n",
    "print(f\"y inicial: {y_grid[0]:.3f} m\")\n",
    "print(f\"y final:   {y_grid[-1]:.3f} m\")\n",
    "print(f\"Margen izquierdo: {left_margin:.3f} m\")\n",
    "print(f\"Margen derecho:   {right_margin:.3f} m\")\n",
    "print(f\"Margen inferior:  {bottom_margin:.3f} m\")\n",
    "print(f\"Margen superior:  {top_margin:.3f} m\")\n",
    "print(f\"Electrodos únicos en la malla numérica: {len(unique_p)} / {n_elec}\")\n",
    "\n",
    "# ============================================================\n",
    "# Configuración de estilo y exportación de figuras\n",
    "# ============================================================\n",
    "\n",
    "fig_dir_b6 = \"figuras_bloque_6_malla_cuadrada_96\"\n",
    "os.makedirs(fig_dir_b6, exist_ok=True)\n",
    "\n",
    "SAVE_FIGS_B6 = True\n",
    "SAVE_PDF_B6 = True\n",
    "SAVE_PNG_B6 = True\n",
    "fig_dpi_b6 = 300\n",
    "\n",
    "mpl.rcParams[\"font.family\"] = \"Times New Roman\"\n",
    "mpl.rcParams[\"mathtext.fontset\"] = \"stix\"\n",
    "mpl.rcParams[\"axes.unicode_minus\"] = False\n",
    "\n",
    "mpl.rcParams[\"font.size\"] = 11\n",
    "mpl.rcParams[\"axes.titlesize\"] = 12\n",
    "mpl.rcParams[\"axes.labelsize\"] = 11\n",
    "mpl.rcParams[\"xtick.labelsize\"] = 10\n",
    "mpl.rcParams[\"ytick.labelsize\"] = 10\n",
    "mpl.rcParams[\"legend.fontsize\"] = 10\n",
    "mpl.rcParams[\"figure.titlesize\"] = 13\n",
    "\n",
    "def savefig_b6(fig, filename_base):\n",
    "    \"\"\"\n",
    "    Guarda figuras del Bloque 6 en PNG y PDF.\n",
    "    \"\"\"\n",
    "    if not SAVE_FIGS_B6:\n",
    "        return\n",
    "\n",
    "    if SAVE_PNG_B6:\n",
    "        png_path = os.path.join(fig_dir_b6, filename_base + \".png\")\n",
    "        fig.savefig(\n",
    "            png_path,\n",
    "            dpi=fig_dpi_b6,\n",
    "            bbox_inches=\"tight\",\n",
    "            facecolor=\"white\"\n",
    "        )\n",
    "        print(f\"Figura guardada: {os.path.abspath(png_path)}\")\n",
    "\n",
    "    if SAVE_PDF_B6:\n",
    "        pdf_path = os.path.join(fig_dir_b6, filename_base + \".pdf\")\n",
    "        fig.savefig(\n",
    "            pdf_path,\n",
    "            bbox_inches=\"tight\",\n",
    "            facecolor=\"white\"\n",
    "        )\n",
    "        print(f\"Figura guardada: {os.path.abspath(pdf_path)}\")\n",
    "\n",
    "# ============================================================\n",
    "# Bordes para visualización con malla uniforme o padding\n",
    "# ============================================================\n",
    "\n",
    "x_edges_plot = globals().get(\"x_edges\", np.linspace(0.0, Lx, nx + 1))\n",
    "y_edges_plot = globals().get(\"y_edges\", np.linspace(0.0, Ly, ny + 1))\n",
    "z_edges_plot = globals().get(\"z_edges\", np.linspace(0.0, Lz, nz + 1))\n",
    "\n",
    "# ============================================================\n",
    "# Visualización 1: corte x-z con proyección de electrodos\n",
    "# ============================================================\n",
    "\n",
    "iy_mid = int(np.argmin(np.abs(y_c - 0.5 * Ly)))\n",
    "\n",
    "rho_xz = rho[:, iy_mid, :].T\n",
    "\n",
    "fig, ax = plt.subplots(figsize=(7.0, 5.2))\n",
    "\n",
    "im = ax.pcolormesh(\n",
    "    x_edges_plot,\n",
    "    z_edges_plot,\n",
    "    rho_xz,\n",
    "    shading=\"auto\",\n",
    "    cmap=\"turbo\"\n",
    ")\n",
    "\n",
    "cbar = fig.colorbar(im, ax=ax)\n",
    "cbar.set_label(r\"$\\rho$ [$\\Omega\\cdot$m]\")\n",
    "\n",
    "# Proyección de todos los electrodos sobre el corte x-z.\n",
    "# Como los electrodos están distribuidos en y, aquí se observa su proyección en x.\n",
    "ax.scatter(\n",
    "    x_elec,\n",
    "    np.zeros_like(x_elec),\n",
    "    s=18,\n",
    "    c=\"k\",\n",
    "    alpha=0.65,\n",
    "    label=\"Proyección de electrodos en superficie\"\n",
    ")\n",
    "\n",
    "ax.set_title(r\"Resistividad $\\rho$ — corte x-z con proyección de la malla\")\n",
    "ax.set_xlabel(\"x [m]\")\n",
    "ax.set_ylabel(\"z [m]\")\n",
    "ax.invert_yaxis()\n",
    "ax.legend(framealpha=0.9)\n",
    "\n",
    "plt.tight_layout()\n",
    "\n",
    "savefig_b6(\n",
    "    fig,\n",
    "    \"bloque6_malla_cuadrada_96_proyeccion_xz\"\n",
    ")\n",
    "\n",
    "plt.show()\n",
    "\n",
    "# ============================================================\n",
    "# Visualización 2: corte x-y a una profundidad fija\n",
    "# ============================================================\n",
    "\n",
    "z_slice = 1.0\n",
    "k_slice = int(np.argmin(np.abs(z_c - z_slice)))\n",
    "\n",
    "rho_xy = rho[:, :, k_slice].T\n",
    "\n",
    "fig, ax = plt.subplots(figsize=(6.8, 5.8))\n",
    "\n",
    "im = ax.pcolormesh(\n",
    "    x_edges_plot,\n",
    "    y_edges_plot,\n",
    "    rho_xy,\n",
    "    shading=\"auto\",\n",
    "    cmap=\"turbo\"\n",
    ")\n",
    "\n",
    "cbar = fig.colorbar(im, ax=ax)\n",
    "cbar.set_label(r\"$\\rho$ [$\\Omega\\cdot$m]\")\n",
    "\n",
    "# Cuadro de adquisición de 25 m x 25 m\n",
    "ax.plot(\n",
