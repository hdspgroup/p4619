    "    rho_app_export = np.asarray(rho_a, dtype=float)\n",
    "    rho_app_type = \"rho_a\"\n",
    "\n",
    "elif \"rho_app\" in globals():\n",
    "    rho_app_export = np.asarray(rho_app, dtype=float)\n",
    "    rho_app_type = \"rho_app\"\n",
    "\n",
    "else:\n",
    "    raise NameError(\"No se encontró rho_a_num, rho_a ni rho_app.\")\n",
