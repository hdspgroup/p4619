    "\n",
    "if USE_RANDOM_SUBSAMPLING:\n",
    "    if not (0.0 < MEASUREMENT_KEEP_FRACTION <= 1.0):\n",
    "        raise ValueError(\"MEASUREMENT_KEEP_FRACTION debe estar en (0, 1].\")\n",
    "\n",
