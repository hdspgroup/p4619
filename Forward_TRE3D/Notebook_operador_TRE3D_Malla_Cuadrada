    "# Validación de variables requeridas\n",
    "# ============================================================\n",
    "\n",
    "required_b7b = [\n",
    "    \"measurements_pp\",\n",
    "    \"data_dV\",\n",
    "    \"electrode_xyz\",\n",
    "    \"electrode_p\",\n",
    "    \"x_elec\",\n",
    "    \"y_elec\",\n",
